registry=https://registry.npmmirror.com
# 用 ~ 而不是绝对路径：mac/Linux/Windows 都能正确展开，避免把开发者主目录写死
cache=~/.npm-omnizip-cache
fund=false
audit=false
loglevel=warn

# 二进制镜像（Electron 官方文档推荐的配置方式）。
# npm 会把它作为 npm_config_electron_mirror 传给子进程，@electron/get 与
# app-builder-lib 都从这里读。国内网络直连 GitHub 会 ECONNRESET，删掉即装不上。
# 注：npm 11 会对这类非标准键打印 "Unknown project config" 警告，属预期，可忽略。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
